# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Database path (defaults to pe_deals.db in current directory)
# DATABASE_PATH=pe_deals.db

# Optional: Gmail credentials path (defaults to credentials.json)
# GMAIL_CREDENTIALS_PATH=credentials.json

# Optional: Gmail token path (defaults to token.json)
# GMAIL_TOKEN_PATH=token.json
